# Copy this file to .env (same folder) and fill in real values. Never commit .env.

# Postgres connection string for Tiger Data.
# Get it from: Tiger Cloud console -> your service -> Connect -> connection string.
# Use the DIRECT connection (not the pooler), then append &uselibpqcompat=true:
# Tiger signs its TLS cert with its own CA, and without this flag the pg library rejects it.
# (The connection is still encrypted, the same as psql with sslmode=require.)
# Looks like: postgres://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require&uselibpqcompat=true
DATABASE_URL=

# Port the API listens on. Optional; defaults to 3000.
PORT=3000
