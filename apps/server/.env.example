# Copy this file to .env (same folder) and fill in real values. Never commit .env.

# Postgres connection string for Tiger Data.
# Get it from: Tiger Cloud console -> your service -> Connect -> connection string.
# Looks like: postgres://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
DATABASE_URL=

# Port the API listens on. Optional; defaults to 3000.
PORT=3000
