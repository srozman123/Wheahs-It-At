{
  "name": "@wheahs/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:setup": "tsx src/scripts/setup.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:clear-seed": "tsx src/scripts/clear-seed.ts",
    "import": "tsx src/import/cli.ts all",
    "import:fetch": "tsx src/import/cli.ts fetch",
    "import:normalize": "tsx src/import/cli.ts normalize",
    "import:save": "tsx src/import/cli.ts save",
    "import:clear": "tsx src/import/cli.ts clear"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.9.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "hono": "^4.13.19",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
